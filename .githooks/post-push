#!/bin/bash
#
# post-push hook: auto-deploy family-tapestry to Vercel production.
#
# Fires after `git push` succeeds. It redeploys to production so the live
# site always matches origin/master without a manual step.
#
# Enabled on this machine via:
#   git config core.hooksPath .githooks
#
# This only auto-deploys when it finds a working Vercel CLI auth. Machines
# without the CLI/auth (or Windows) simply skip silently — waiting for a
# manual `vercel --prod` — so the hook is safe to leave enabled everywhere.

# Only run for pushes that touch the production branch (master).
# $1 = remote, $2 = URL. We look at refspecs passed on stdin: "refname old new".
if [ -t 0 ]; then
  exit 0
fi

proceed=0
while read oldrev newrev ref; do
  [ -z "$ref" ] && continue
  case "$ref" in
    refs/heads/master) proceed=1 ;;
  esac
done

[ "$proceed" = "1" ] || exit 0

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
  nvm use 22 >/dev/null 2>&1 || true
fi

command -v vercel >/dev/null 2>&1 || { echo "[post-push] vercel CLI not found — skipping auto-deploy"; exit 0; }

# Verify the CLI is actually authenticated before spending a build.
if ! vercel whoami >/dev/null 2>&1; then
  echo "[post-push] vercel CLI not authenticated — skipping auto-deploy"
  exit 0
fi

echo "[post-push] push to master detected — deploying to Vercel production..."
vercel --prod --yes >/tmp/opencode/post-push-deploy.log 2>&1
status=$?
if [ "$status" = "0" ]; then
  echo "[post-push] deployed: https://family-tapestry-nine.vercel.app"
else
  echo "[post-push] deployment failed (see /tmp/opencode/post-push-deploy.log)"
fi
exit "$status"
