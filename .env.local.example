# ============================================
# Family Tapestry — Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# Get Supabase keys from: https://supabase.com/dashboard → Project Settings → API
# Get R2 keys from: https://dash.cloudflare.com → R2 Object Storage → Manage R2 API Tokens

# --- Supabase (required) ---

# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (server-side only, bypasses RLS — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Cloudflare R2 (optional — for photo uploads) ---

# Cloudflare account ID (found on the R2 dashboard right sidebar)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token access key ID
R2_ACCESS_KEY_ID=your-r2-access-key

# R2 API token secret access key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# R2 bucket name (create one at https://dash.cloudflare.com → R2)
R2_BUCKET_NAME=your-bucket-name

# Public URL for serving uploaded images (e.g., https://pub-xxx.r2.dev or custom domain)
R2_PUBLIC_URL=https://your-bucket.your-r2.dev
